{
  "name": "git-branch-panel",
  "displayName": "Git Branch Panel",
  "description": "Панели Проводника. GitHub: создать репозиторий и подключить его к GitHub, Commit, Push, Pull и ветки от имени владельца репозитория; каждая команда git видна в терминале Git Bash. npm-скрипты: npm run dev и другие скрипты package.json одним щелчком в терминале со ссылкой на сервер.",
  "version": "1.9.2",
  "publisher": "workstation",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:workstationGithubPanel",
    "onView:workstationNpmScripts",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "package.nls.json",
    "package.nls.ru.json",
    "src/text.js",
    "src/shell.js",
    "src/git-runner.js",
    "src/git-terminal.js",
    "src/git-errors.js",
    "src/git-state.js",
    "src/github-api.js",
    "src/commit-suggest.js",
    "src/identity.js",
    "src/npm-scripts.js",
    "src/panel-provider.js",
    "src/webview-html.js",
    "src/webview/view.css",
    "src/webview/view.js",
    "src/actions/common.js",
    "src/actions/commit-push.js",
    "src/actions/merge.js",
    "src/actions/branches.js",
    "src/actions/pull-requests.js",
    "src/actions/repository.js",
    "README.md",
    "icon.png",
    "LICENSE.txt"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "workstationGithubPanel",
          "name": "GitHub"
        },
        {
          "id": "workstationNpmScripts",
          "name": "%npmScripts.view%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "workstationNpmScripts",
        "contents": "%npmScripts.empty%"
      }
    ],
    "commands": [
      {
        "command": "workstationGithubPanel.refresh",
        "title": "%githubPanel.refresh%"
      },
      {
        "command": "workstationNpmScripts.refresh",
        "title": "%npmScripts.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "workstationNpmScripts.run",
        "title": "%npmScripts.run%",
        "icon": "$(play)"
      },
      {
        "command": "workstationNpmScripts.stop",
        "title": "%npmScripts.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "workstationNpmScripts.restart",
        "title": "%npmScripts.restart%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "workstationNpmScripts.openUrl",
        "title": "%npmScripts.openUrl%",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workstationNpmScripts.refresh",
          "when": "view == workstationNpmScripts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "workstationNpmScripts.run",
          "when": "view == workstationNpmScripts && viewItem == script",
          "group": "inline"
        },
        {
          "command": "workstationNpmScripts.openUrl",
          "when": "view == workstationNpmScripts && viewItem == serving",
          "group": "inline@1"
        },
        {
          "command": "workstationNpmScripts.restart",
          "when": "view == workstationNpmScripts && viewItem =~ /^(running|serving)$/",
          "group": "inline@2"
        },
        {
          "command": "workstationNpmScripts.stop",
          "when": "view == workstationNpmScripts && viewItem =~ /^(running|serving)$/",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "workstationNpmScripts.run",
          "when": "false"
        },
        {
          "command": "workstationNpmScripts.stop",
          "when": "false"
        },
        {
          "command": "workstationNpmScripts.restart",
          "when": "false"
        },
        {
          "command": "workstationNpmScripts.openUrl",
          "when": "false"
        }
      ]
    }
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/m-safarov/antigravity-workstation.git",
    "directory": "extensions/git-branch-panel"
  }
}
