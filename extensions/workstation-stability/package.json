{
  "name": "stability-helper",
  "displayName": "Workstation Stability",
  "description": "Применяет профиль редактора и проверяет конфликты настроек.",
  "publisher": "workstation",
  "version": "1.4.2",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Workstation Stability",
      "properties": {
        "workstationStability.autoUpdateExcludedExtensions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "application",
          "description": "Managed gallery extension IDs to leave to the user instead of the Workstation updater. Uninstalled extensions are never reinstalled by the background updater."
        },
        "workstationStability.autoUpdateManagedExtensions": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Check managed gallery extensions daily through the verified Workstation updater. This does not enable the IDE's native per-extension auto-update switch or update local Workstation VSIX packages."
        },
        "workstationStability.ai.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Enable optional local AI assistance (setup recovery suggestions and GitHub panel commit-message drafting). Core installation, Git, and IDE features work without AI."
        },
        "workstationStability.ai.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "openai-compatible"
          ],
          "default": "gemini",
          "scope": "application",
          "description": "Provider format for optional local AI requests. The API key itself is stored separately in IDE SecretStorage via Configure AI API Key."
        },
        "workstationStability.ai.endpoint": {
          "type": "string",
          "default": "https://generativelanguage.googleapis.com/v1beta",
          "scope": "application",
          "description": "HTTPS endpoint for the configured AI provider (kept separate from the API key in SecretStorage)."
        },
        "workstationStability.ai.model": {
          "type": "string",
          "default": "gemini-3.5-flash-lite",
          "scope": "application",
          "description": "Model identifier used by optional local AI assistance (API key comes from IDE SecretStorage or private ~/.gemini/config/workstation-setup/.env)."
        },
        "workstationStability.ai.proxyUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional HTTPS proxy URL (e.g. a Cloudflare Worker or Vercel route from services/commit-ai-proxy) for shared commit-message AI suggestions when no personal API key is configured. The upstream API key stays strictly on the server."
        }
      }
    },
    "commands": [
      {
        "command": "workstationStability.configureAiApiKey",
        "title": "Workstation: Configure AI API Key"
      },
      {
        "command": "workstationStability.testAiConnection",
        "title": "Workstation: Test AI Connection"
      },
      {
        "command": "workstationStability.questions",
        "title": "Workstation: Вопросы задачи (галочки и свой вариант)"
      },
      {
        "command": "workstationStability.status",
        "title": "Workstation: Check Antigravity Stability"
      },
      {
        "command": "workstationStability.repair",
        "title": "Workstation: Restore Known Extension Fixes"
      },
      {
        "command": "workstationStability.reconnectMcp",
        "title": "Workstation: Reconnect MCP (Reload Window)"
      },
      {
        "command": "workstationStability.applySettings",
        "title": "Workstation: Apply and Check Editor Settings"
      },
      {
        "command": "workstationStability.inspectConflicts",
        "title": "Workstation: Inspect Project Setting Conflicts (Read Only)"
      },
      {
        "command": "workstationStability.retrySetupRepair",
        "title": "Workstation: Retry Setup Repair Task in Current Chat"
      }
    ],
    "keybindings": [
      {
        "key": "tab",
        "command": "acceptSelectedSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible && suggestWidgetHasFocusedSuggestion && !editorReadonly && !tabMovesFocus"
      },
      {
        "key": "ctrl+alt+f",
        "command": "editor.action.formatDocument",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "shift+alt+f",
        "command": "editor.action.formatDocument",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+space",
        "command": "editor.action.triggerSuggest",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "alt+space",
        "command": "editor.action.triggerSuggest",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+z",
        "command": "undo",
        "when": "editorTextFocus && !editorReadonly && antigravity.inlineDiffCanUndo && !antigravity.hasActiveDiff && config.antigravity.enableInlineDiff == false"
      },
      {
        "key": "ctrl+y",
        "command": "redo",
        "when": "editorTextFocus && !editorReadonly && antigravity.inlineDiffCanRedo && !antigravity.hasActiveDiff && config.antigravity.enableInlineDiff == false"
      },
      {
        "key": "ctrl+shift+z",
        "command": "redo",
        "when": "!isMac && editorTextFocus && !editorReadonly && antigravity.inlineDiffCanRedo && !antigravity.hasActiveDiff && config.antigravity.enableInlineDiff == false"
      },
      {
        "key": "ctrl+m",
        "command": "-antigravity.startVoiceRecording"
      },
      {
        "key": "ctrl+m",
        "command": "-antigravity.toggleVoiceRecording"
      },
      {
        "key": "m",
        "command": "-antigravity.stopVoiceRecording"
      },
      {
        "key": "enter",
        "command": "-antigravity.startVoiceRecording"
      },
      {
        "key": "enter",
        "command": "-antigravity.toggleVoiceRecording"
      },
      {
        "key": "ctrl+enter",
        "command": "-antigravity.startVoiceRecording"
      },
      {
        "key": "ctrl+enter",
        "command": "-antigravity.toggleVoiceRecording"
      },
      {
        "key": "shift+enter",
        "command": "-antigravity.startVoiceRecording"
      },
      {
        "key": "shift+enter",
        "command": "-antigravity.toggleVoiceRecording"
      },
      {
        "key": "ctrl+m",
        "command": "-workbench.action.speech.startVoiceChat"
      },
      {
        "key": "ctrl+m",
        "command": "-workbench.action.speech.startListening"
      },
      {
        "key": "ctrl+m",
        "command": "-workbench.action.speech.stopListening"
      }
    ]
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/m-safarov/antigravity-workstation.git",
    "directory": "extensions/workstation-stability"
  }
}
