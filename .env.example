# Optional local AI key for Workstation Stability (setup recovery) & GitHub Panel (Tab commit suggestions).
# NEVER commit a real `.env` file to Git.
#
# Preferred option (inside Antigravity IDE):
#   Ctrl+Shift+P -> "Workstation: Configure AI API Key" (stores securely in IDE SecretStorage)
#
# Alternative local user-private .env file (outside every Git repository, works across all projects):
#   %USERPROFILE%\.gemini\config\workstation-setup\.env
#
# Example format (replace placeholder with your own personal key):
WORKSTATION_AI_API_KEY=<YOUR_AI_API_KEY>
